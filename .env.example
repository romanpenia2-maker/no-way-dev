# Site URL used for metadataBase / sitemap in production
NEXT_PUBLIC_SITE_URL=https://no-way.dev

# --- Phase 3 (NOT required for the current static build) ---
# Resend API key for the email-capture form (stub, see src/components/email-capture.tsx)
RESEND_API_KEY=
# Audience / segment id in Resend
RESEND_AUDIENCE_ID=

# Telegram bot notifications for the price-update workflow (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub token used by scripts/bots/* when creating PRs (CI uses GITHUB_TOKEN automatically)
GITHUB_TOKEN=

# --- AI detector (/ai-detector + /api/detect) — all optional ---
# Without keys the page still works: client-side C2PA + server metadata heuristics;
# each ML layer reports itself as "unavailable" instead of fabricating scores.
# DeepInfra (primary) — zero-shot scoring + family attribution via echo logprobs
DEEPINFRA_API_KEY=
# Together AI (fallback provider if DeepInfra key is absent)
TOGETHER_API_KEY=
# Sightengine — external second opinion for images (free tier)
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# Sapling — external second opinion for borderline text (metered)
SAPLING_API_KEY=
