# Site URL used for metadataBase / sitemap in production
NEXT_PUBLIC_SITE_URL=https://no-way.dev

# --- Phase 3 (NOT required for the current static build) ---
# Resend API key for the email-capture form (stub, see src/components/email-capture.tsx)
RESEND_API_KEY=
# Audience / segment id in Resend
RESEND_AUDIENCE_ID=

# Telegram bot notifications for the price-update workflow (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub token used by scripts/bots/* when creating PRs (CI uses GITHUB_TOKEN automatically)
GITHUB_TOKEN=
